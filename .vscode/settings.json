{

    "java.debug.settings.onBuildFailureProceed": true,
    "java.debug.settings.hotCodeReplace": "manual",

    // ============================================================
    // TRADUCTION
    // ============================================================
    "commentTranslate.hover.enabled": false,

    // ============================================================
    // MÉMOIRE DU SERVEUR JAVA (Language Server)
    // ============================================================
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx8G -Xms256m -Xlog:disable",

    // ============================================================
    // CONFIGURATION DU PROJET (ESSENTIEL)
    // ============================================================
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.import.maven.enabled": true,
    "java.maven.downloadSources": false,

    // ============================================================
    // CHEMINS SOURCES ET SORTIE
    // ============================================================
    "java.project.sourcePaths": [
        "src/main/java"
    ],
    "java.project.outputPath": "target/classes",
    "java.project.resourceFilters": [
        "node_modules",
        ".git",
        "target"
    ],

    // ============================================================
    // COMPILATION AUTOMATIQUE
    // ============================================================
    "java.autobuild.enabled": false,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "never"
    },

    // ============================================================
    // NETTOYAGE ET PERFORMANCE
    // ============================================================
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/target": false,
        "**/node_modules": true
    },
    "search.exclude": {
        "**/target": true,
        "**/node_modules": true
    },

    // ============================================================
    // FORMAT / ENCODAGE
    // ============================================================
    "files.encoding": "utf8",
    "files.eol": "\n",
    "editor.formatOnSave": false,
    "editor.tabSize": 4,

    // ============================================================
    // COMPLÉTION / INTELLISENSE
    // ============================================================
    "java.completion.enabled": true,
    "java.completion.guessMethodArguments": "insertBestGuessedArguments",
    "java.signatureHelp.enabled": true,
    "java.referencesCodeLens.enabled": false,

    // ============================================================
    // RECOMMANDATIONS D'EXTENSIONS
    // ============================================================
    "java.format.settings.url": "",
    "java.format.settings.profile": ""
}